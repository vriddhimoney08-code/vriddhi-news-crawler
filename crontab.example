# Vriddhi News Crawler & Broadcast Crontab (Timezone: Asia/Kolkata)
# To set server timezone: sudo timedatectl set-timezone Asia/Kolkata

# 1. Background News Crawling (Every 20 minutes)
*/20 * * * * cd /opt/vriddhi-news-crawler && PYTHONPATH=/opt/vriddhi-news-crawler PYTHONUNBUFFERED=1 /opt/vriddhi-news-crawler/.venv/bin/python -u -m vriddhi_crawler crawl >> /opt/vriddhi-news-crawler/crawl.log 2>&1

# 2. Morning Company Digest (Daily at 8:30 AM IST)
30 8 * * * cd /opt/vriddhi-news-crawler && PYTHONPATH=/opt/vriddhi-news-crawler PYTHONUNBUFFERED=1 /opt/vriddhi-news-crawler/.venv/bin/python -u -m vriddhi_crawler digest --send-whatsapp >> /opt/vriddhi-news-crawler/morning.log 2>&1

# 3. Evening Macro & Sector Briefing (Daily at 5:15 PM IST)
15 17 * * * cd /opt/vriddhi-news-crawler && PYTHONPATH=/opt/vriddhi-news-crawler PYTHONUNBUFFERED=1 /opt/vriddhi-news-crawler/.venv/bin/python -u -m vriddhi_crawler macro-dispatch --send-whatsapp >> /opt/vriddhi-news-crawler/evening.log 2>&1

