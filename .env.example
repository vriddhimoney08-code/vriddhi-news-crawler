# Copy this file to .env and fill it in.  cp .env.example .env
# Never share .env by e-mail or chat: it holds your Interakt key and storage keys.

# ---------- Safety switch ----------
# While YES, every digest goes to TEST_WHATSAPP instead of the analysts, and nothing is archived.
TEST_MODE=yes
TEST_WHATSAPP=9820000000

# ---------- Interakt (Growth plan or above) ----------
# Interakt > Settings > Developer Settings > Secret Key
INTERAKT_API_KEY=
# the template's code name: the part of app.interakt.ai/template/<code-name>/view
INTERAKT_TEMPLATE=vriddhi_daily_digest
INTERAKT_LANGUAGE=en
# yes = template has a Document header and the PDF is attached to the message (recommended)
INTERAKT_DOCUMENT_HEADER=yes

# ---------- PDF hosting (any S3-compatible storage) ----------
# Interakt downloads the PDF from a private, expiring link. AWS S3, DigitalOcean Spaces and
# Cloudflare R2 all work. Leave S3_ENDPOINT_URL blank for AWS S3.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_LINK_DAYS=7

# ---------- Control panel and archive ----------
# Blank = use control_panel.xlsx in this folder. Set to a Google Sheet ID to edit it in Google Sheets instead
# (share the sheet with the service account's e-mail and put its key file at GOOGLE_CREDENTIALS_JSON).
GOOGLE_SHEET_ID=
ARCHIVE_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=./google-service-account.json

# ---------- Crawling ----------
# shown to websites in the crawler's user agent, so a publisher can contact you
CRAWLER_CONTACT_EMAIL=research@yourdomain.com
PER_HOST_DELAY_SEC=2
RESPECT_ROBOTS=yes
MAX_ITEM_AGE_HOURS=48
BODY_FETCH_LIMIT=300
GOOGLE_NEWS_EDITIONS=en-IN,hi-IN
GOOGLE_NEWS_EVERY_MIN=180
GDELT_EVERY_MIN=180
PAGES_EVERY_MIN=1440

# ---------- Digest ----------
DIGEST_MAX_AGE_HOURS=36
TOP_HEADLINES=5

# ---------- 8:20 status to you (either or both) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
STATUS_EMAIL_TO=
# a second Interakt template with one variable, e.g. "Digest status: {{1}}"
INTERAKT_STATUS_TEMPLATE=
ADMIN_WHATSAPP=
